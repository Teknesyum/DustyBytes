<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DustyBytes.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://DustyBytes/Assets/Theme.axaml" />
    <StyleInclude Source="avares://DustyBytes/Kabuk/KabukStilleri.axaml" />
    <StyleInclude Source="avares://DustyBytes/Assets/AppStyles.axaml" />
  </Application.Styles>
</Application>

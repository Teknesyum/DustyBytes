<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DustyBytes.App.ViewModels"
             xmlns:v="using:DustyBytes.App.Views"
             xmlns:u="using:DustyBytes.Clean.Uninstall"
             x:Class="DustyBytes.App.Views.UninstallView"
             x:DataType="vm:UninstallViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,24,24,12" Spacing="{StaticResource FieldGap}">
      <Button Classes="link" Content="Programlara dön" HorizontalAlignment="Left" Command="{Binding BackCommand}"/>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Theme="{StaticResource H2}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Theme="{StaticResource Hint}" Text="{Binding Publisher}"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Theme="{StaticResource Body}" Text="{Binding Summary}" TextWrapping="Wrap"/>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderDecorative}"
            BorderThickness="0,1,0,0" Padding="{StaticResource PanelPadding}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Theme="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding BottomTip}" IsVisible="{Binding ShowBottomTip}"/>
        <Button Name="UninstallRun" Grid.Column="1" Classes="danger" Content="Programı kaldır"
                IsVisible="{Binding ShowUninstallRun}" Command="{Binding UninstallCommand}"
                ToolTip.Tip="Onay sorulur; önce geri yükleme noktası oluşturulur" ToolTip.ShowOnDisabled="True"/>
        <Button Name="ForceRun" Grid.Column="1" Classes="danger" Content="Zorla kaldır"
                IsVisible="{Binding ForceOffered}" Command="{Binding ForceCommand}"
                ToolTip.Tip="{Binding BottomTip}" ToolTip.ShowOnDisabled="True"/>
        <Button Name="RemoveLeftovers" Grid.Column="1" Classes="danger" Content="Seçili kalıntıları sil"
                IsVisible="{Binding ShowRemoveLeftovers}" Command="{Binding RemoveLeftoversCommand}"
                ToolTip.Tip="{Binding RemoveTip}" ToolTip.ShowOnDisabled="True"/>
      </Grid>
    </Border>

    <Panel DockPanel.Dock="Top" Margin="24,0,24,12" IsVisible="{Binding IsBusy}">
      <v:TaskProgressView DataContext="{Binding Progress}"/>
    </Panel>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,0,24,24" Spacing="{StaticResource SectionGap}">
        <Border Theme="{StaticResource Panel}" IsVisible="{Binding HasError}">
          <TextBlock Theme="{StaticResource DangerBody}" Text="{Binding Error}" TextWrapping="Wrap"/>
        </Border>

        <Border Name="VendorCard" Theme="{StaticResource Panel}" IsVisible="{Binding VendorVisible}">
          <StackPanel Spacing="{StaticResource FieldGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Sıra sizde"/>
            <TextBlock Theme="{StaticResource Body}" Text="{Binding VendorCard}" TextWrapping="Wrap"/>
            <TextBlock Theme="{StaticResource Hint}" Text="Sessiz kaldırma olmadı. Açılan pencere programın kendi kaldırıcısıdır; biz ona tıklamayız." TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Name="ForceCard" Theme="{StaticResource Panel}" IsVisible="{Binding ForceOffered}">
          <StackPanel Spacing="{StaticResource FieldGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Zorla kaldırma"/>
            <TextBlock Theme="{StaticResource Body}" Text="{Binding ForceReason}" TextWrapping="Wrap"/>
            <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap"
                       Text="Zorla kaldırmada programın kaldırıcısı çalıştırılmaz. DustyBytes kurulum klasörünü ve yayıncının izlerini kendisi bulur."/>
            <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap"
                       Text="Yalnız iki bağımsız kanıtla bu programa bağlanan yüksek güvenli izler 7 gün karantinaya alınır; kayıt anahtarları önce .reg dosyasına yedeklenir."/>
            <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap"
                       Text="Programın listedeki kaydı ancak dosyaları gittikten sonra silinir. Kurulum klasörü taşınamazsa kayıt yerinde kalır."/>
            <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Korunanlar: orta ve düşük güvenli izler işaretsiz kalır. Kişisel klasörleriniz (belgeler, masaüstü, indirilenler) ve başka programların klasörleri asla silinmez."/>
            <CheckBox Name="ForceKeepSettingsOption" IsChecked="{Binding KeepSettings}">
              <TextBlock Theme="{StaticResource Body}" Text="Ayarları koru (yeniden kurarsanız ayarlarınız yerinde olur)" TextWrapping="Wrap"/>
            </CheckBox>
          </StackPanel>
        </Border>

        <Border Theme="{StaticResource Panel}" IsVisible="{Binding ShowUninstallRun}">
          <StackPanel Spacing="{StaticResource FieldGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Kaldırma biçimi"/>
            <CheckBox Name="AutoCleanOption" IsChecked="{Binding AutoClean}">
              <TextBlock Theme="{StaticResource Body}" Text="Kesin kalıntıları hemen temizle (kayıt yedeği alınır, dosyalar 7 gün karantinada kalır)" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox Name="KeepSettingsOption" IsChecked="{Binding KeepSettings}" IsEnabled="{Binding AutoClean}">
              <TextBlock Theme="{StaticResource Body}" Text="Ayarları koru (yeniden kurarsanız ayarlarınız yerinde olur)" TextWrapping="Wrap"/>
            </CheckBox>
          </StackPanel>
        </Border>

        <Border Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource FieldGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Adımlar"/>
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UninstallStep">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <StackPanel>
                      <TextBlock Theme="{StaticResource Body}" Text="{Binding Label}"/>
                      <TextBlock Theme="{StaticResource Hint}" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Theme="{StaticResource Label}" Text="{Binding StateText}" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Theme="{StaticResource Panel}" IsVisible="{Binding HasCleaned}">
          <StackPanel Spacing="{StaticResource FieldGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Temizlenenler"/>
            <TextBlock Theme="{StaticResource Hint}" Text="{Binding CleanedText}" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding Cleaned}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="u:RemovalItem">
                  <StackPanel Margin="0,4">
                    <TextBlock Theme="{StaticResource Body}" FontFamily="{StaticResource FontMono}" Text="{Binding Target}" TextTrimming="PathSegmentEllipsis"/>
                    <TextBlock Theme="{StaticResource Hint}" Text="{Binding Message}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource FieldGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Olası kalıntılar"/>
            <TextBlock Theme="{StaticResource Hint}" Text="{Binding LeftoverHint}" TextWrapping="Wrap"/>
            <TextBlock Theme="{StaticResource Hint}" Text="Kalıntı bulunmadı" IsVisible="{Binding !HasLeftovers}"/>
            <ItemsControl ItemsSource="{Binding Leftovers}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="{StaticResource FieldGap}"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LeftoverRow">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,12,0"
                              AutomationProperties.Name="{Binding Target}"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Theme="{StaticResource Body}" FontFamily="{StaticResource FontMono}" Text="{Binding Target}" TextTrimming="PathSegmentEllipsis"/>
                      <TextBlock Theme="{StaticResource Hint}">
                        <Run Text="{Binding KindLabel}"/><Run Text=" · "/><Run Text="{Binding TierText}"/><Run Text=" · "/><Run Text="{Binding Reason}"/>
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="link" HorizontalAlignment="Left" Content="{Binding MoreText}" IsVisible="{Binding HasMore}" Command="{Binding ShowMoreCommand}"/>
          </StackPanel>
        </Border>

        <Border Theme="{StaticResource Panel}" IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Spacing="{StaticResource FieldGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Notlar"/>
            <TextBlock Theme="{StaticResource Hint}" Text="{Binding Notes}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

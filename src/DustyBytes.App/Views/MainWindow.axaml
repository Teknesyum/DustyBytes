<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DustyBytes.App.ViewModels"
        xmlns:v="using:DustyBytes.App.Views"
        x:Class="DustyBytes.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DustyBytes"
        Width="1200" Height="780" MinHeight="640"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{StaticResource AppBg}">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:OverviewViewModel"><v:OverviewView/></DataTemplate>
    <DataTemplate DataType="vm:OffersViewModel"><v:OffersView/></DataTemplate>
    <DataTemplate DataType="vm:MapViewModel"><v:MapView/></DataTemplate>
    <DataTemplate DataType="vm:ProgramsViewModel"><v:ProgramsView/></DataTemplate>
    <DataTemplate DataType="vm:UninstallViewModel"><v:UninstallView/></DataTemplate>
    <DataTemplate DataType="vm:CleanupViewModel"><v:CleanupView/></DataTemplate>
    <DataTemplate DataType="vm:QuarantineViewModel"><v:QuarantineView/></DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <Panel Classes="appbg" Background="{StaticResource AppBgGradient}" IsHitTestVisible="False"/>

    <DockPanel>
      <Grid Name="TitleBar" DockPanel.Dock="Top" Height="{StaticResource TitleBarHeightMax}"
            Background="Transparent" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Theme="{StaticResource Label}" Text="DustyBytes" VerticalAlignment="Center" Margin="16,0,12,0" IsHitTestVisible="False"/>
        <Border Grid.Column="1" IsVisible="{Binding IsDryRun}" BorderBrush="{StaticResource Warning50}"
                BorderThickness="{StaticResource BorderWidth}" CornerRadius="{StaticResource Radius}"
                Padding="8,0" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Theme="{StaticResource WarningBody}" FontSize="{StaticResource FontSize1}" Text="{Binding DryRunText}"/>
        </Border>
        <Button Name="UpdateBadge" Grid.Column="3" Theme="{StaticResource BadgeButton}" Classes="update"
                Classes.ready="{Binding Update.IsReady}" Margin="0,0,8,0"
                IsVisible="{Binding Update.IsVisible}" Command="{Binding Update.ActCommand}"
                ToolTip.Tip="{Binding Update.Tip}" AutomationProperties.Name="{Binding Update.Tip}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <Ellipse Name="UpdateDot" Width="{StaticResource Space2}" Height="{StaticResource Space2}"
                     Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
            <TextBlock Name="UpdateText" Text="{Binding Update.Text}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <v:SignatureView Name="Signature" Grid.Column="4" Margin="0,0,12,0"/>
        <Button Name="MinimizeButton" Grid.Column="5" Theme="{StaticResource WindowButton}"
                AutomationProperties.Name="Simge durumuna küçült" ToolTip.Tip="Simge durumuna küçült">
          <Path Data="M0 0H10" Stroke="{StaticResource TextBody}" StrokeThickness="1" Width="10" MinHeight="1" VerticalAlignment="Center"/>
        </Button>
        <Button Name="MaximizeButton" Grid.Column="6" Theme="{StaticResource WindowButton}"
                AutomationProperties.Name="Ekranı kapla" ToolTip.Tip="Ekranı kapla">
          <Path Data="M0 0H10V10H0Z" Stroke="{StaticResource TextBody}" StrokeThickness="1" Width="10" MinHeight="10"/>
        </Button>
        <Button Name="CloseButton" Grid.Column="7" Classes="close" Theme="{StaticResource WindowButton}"
                AutomationProperties.Name="Kapat" ToolTip.Tip="Kapat">
          <Path Data="M0 0L10 10M10 0L0 10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Width="10" MinHeight="10"/>
        </Button>
      </Grid>

      <Border DockPanel.Dock="Left" Width="{StaticResource SidebarWidth}" Background="{StaticResource Surface}"
              BorderBrush="{StaticResource BorderDecorative}" BorderThickness="0,1,1,0">
        <ListBox Name="Nav" Theme="{StaticResource NavList}" ItemContainerTheme="{StaticResource NavItem}"
                 Margin="12,16" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                 KeyboardNavigation.TabNavigation="Once"
                 AutomationProperties.Name="Ekranlar">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
                <Viewbox Width="{StaticResource IconSize2}" MinHeight="{StaticResource IconSize2}" VerticalAlignment="Center">
                  <Path Data="{Binding Glyph}" Stroke="{StaticResource NeonBlue}" StrokeThickness="1.5"
                        StrokeLineCap="Round" StrokeJoin="Round" Width="24" MinHeight="24"/>
                </Viewbox>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <TransitioningContentControl Name="Pages" Content="{Binding Navigation.Current}"/>
    </DockPanel>

    <ItemsControl Name="Toasts" ItemsSource="{Binding Toasts}" Width="{StaticResource ToastWidth}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="{StaticResource ToastGap}"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ToastViewModel">
          <Border Theme="{StaticResource Panel}" Padding="16" Classes="fade" Classes.error="{Binding IsError}"
                  BorderBrush="{StaticResource BorderStrong}"
                  PointerEntered="OnToastEnter" PointerExited="OnToastExit">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Theme="{StaticResource Body}" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                         IsVisible="{Binding !IsError}"/>
              <TextBlock Theme="{StaticResource DangerBody}" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                         IsVisible="{Binding IsError}"/>
              <Button Grid.Column="1" Classes="ghost" Content="{Binding ActionText}" IsVisible="{Binding HasAction}"
                      Command="{Binding ActCommand}" Margin="12,0,0,0"/>
              <Button Grid.Column="2" Classes="link" Content="Kapat" Command="{Binding DismissCommand}" Margin="8,0,0,0"
                      AutomationProperties.Name="Bildirimi kapat"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Panel Name="ConfirmLayer" IsVisible="{Binding Confirm, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Background="{StaticResource AppBg}" Opacity="0.8"/>
      <Border Name="ConfirmDialog" Theme="{StaticResource Panel}" Width="{StaticResource ModalWidth}"
              HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource BorderStrong}"
              DataContext="{Binding Confirm}" x:DataType="vm:ConfirmViewModel">
        <StackPanel Spacing="{StaticResource FieldGap}">
          <TextBlock Theme="{StaticResource H3}" Text="{Binding Title}" TextWrapping="Wrap"/>
          <TextBlock Theme="{StaticResource Body}" Text="{Binding Message}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space3}" Margin="0,12,0,0">
            <Button Name="ConfirmDecline" Classes="ghost" Content="Vazgeç" Command="{Binding DeclineCommand}" IsCancel="True"/>
            <Button Name="ConfirmDanger" Classes="danger" Content="{Binding ConfirmText}" Command="{Binding AcceptCommand}" IsVisible="{Binding IsDanger}"/>
            <Button Name="ConfirmAccept" Classes="primary" Content="{Binding ConfirmText}" Command="{Binding AcceptCommand}" IsVisible="{Binding !IsDanger}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Panel>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DustyBytes.App.ViewModels"
             xmlns:v="using:DustyBytes.App.Views"
             x:Class="DustyBytes.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource PanelPadding}" Spacing="{StaticResource SectionGap}">

      <WrapPanel ItemSpacing="{StaticResource Space5}" LineSpacing="{StaticResource Space3}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}" VerticalAlignment="Center">
          <TextBlock Theme="{StaticResource H2}" Text="Genel bakış"/>
          <Border IsVisible="{Binding IsRefreshing}" BorderBrush="{StaticResource Renk1}" BorderThickness="{StaticResource BorderWidth}"
                  CornerRadius="{StaticResource Radius}" Padding="8,2" VerticalAlignment="Center"
                  ToolTip.Tip="Önceki sonuç gösteriliyor; yeni tarama arka planda sürüyor">
            <TextBlock Theme="{StaticResource Label}" Text="Tazeleniyor"/>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
          <Button Name="FastScanButton" Classes="ghost" Content="Hızlı tarama (yönetici)"
                  Command="{Binding FastScanCommand}"
                  ToolTip.Tip="{Binding FastScanTip}" ToolTip.ShowOnDisabled="True"/>
          <Button Name="RescanButton" Classes="ghost" Content="Baştan tara"
                  Command="{Binding RescanCommand}" IsVisible="{Binding HasSnapshot}"
                  ToolTip.Tip="{Binding RescanTip}" ToolTip.ShowOnDisabled="True"/>
          <Button Name="ScanButton" Classes.primary="{Binding ScanIsPrimary}" Classes.ghost="{Binding !ScanIsPrimary}" Content="{Binding PrimaryText}"
                  Command="{Binding StartScanCommand}"
                  ToolTip.Tip="{Binding ScanTip}" ToolTip.ShowOnDisabled="True"/>
          <Button Name="AutoButton" Classes="ghost" Content="Otomatik temizle"
                  Command="{Binding AutoCleanCommand}" IsVisible="{Binding HasSnapshot}"
                  ToolTip.Tip="{Binding AutoTip}" ToolTip.ShowOnDisabled="True"/>
        </StackPanel>
      </WrapPanel>

      <Panel IsVisible="{Binding IsScanning}">
        <v:TaskProgressView DataContext="{Binding Progress}"/>
      </Panel>

      <Border Theme="{StaticResource Panel}" IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="{StaticResource FieldGap}">
          <TextBlock Theme="{StaticResource H3}" Text="Henüz tarama yok"/>
          <TextBlock Theme="{StaticResource Hint}" Text="Taramayı başlatın; büyük ve az kullanılan alanlar amacına göre toplanır. Hiçbir dosya silinmez."/>
        </StackPanel>
      </Border>

      <Border Theme="{StaticResource Panel}" IsVisible="{Binding HasError}">
        <StackPanel Spacing="{StaticResource FieldGap}">
          <TextBlock Theme="{StaticResource H3}" Text="Tarama tamamlanamadı"/>
          <TextBlock Theme="{StaticResource DangerBody}" Text="{Binding ErrorText}" TextWrapping="Wrap"/>
          <TextBlock Theme="{StaticResource Hint}" Text="Yeniden dene düğmesiyle taramayı baştan başlatın."/>
        </StackPanel>
      </Border>

      <Border Name="SafePanel" Theme="{StaticResource Panel}" IsVisible="{Binding ShowSafe}">
        <StackPanel Spacing="{StaticResource SectionGap}">
          <StackPanel Spacing="{StaticResource Space1}">
            <TextBlock Theme="{StaticResource H3}" Text="Yer açma planı"/>
            <TextBlock Theme="{StaticResource Hint}" Text="Üstten başla. Her basamak bir öncekinden biraz daha çok karar ister." TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Name="SafeStep" Spacing="{StaticResource FieldGap}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SafeSizeText}" VerticalAlignment="Center"/>
              <TextBlock Theme="{StaticResource Body}" FontWeight="{StaticResource WeightSemi}" Text="1. Güvenli" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Theme="{StaticResource Hint}" Text="{x:Static vm:OverviewViewModel.SafeHow}" TextWrapping="Wrap"/>
            <Button Name="SafeCleanButton" Classes.primary="{Binding !Target.HasPlan}" Classes.ghost="{Binding Target.HasPlan}" HorizontalAlignment="Left"
                    Content="{Binding SafeText}" Command="{Binding SafeCleanCommand}" IsVisible="{Binding ShowSafeButton}"
                    ToolTip.Tip="{Binding SafeTip}" ToolTip.ShowOnDisabled="True"/>
            <TextBlock Name="SafeEmptyText" Theme="{StaticResource Body}" Text="Güvenle silinecek bir şey kalmadı" IsVisible="{Binding IsSafeEmpty}"/>
            <TextBlock Name="SafeReason" Theme="{StaticResource Hint}" Text="{Binding SafeReason}" IsVisible="{Binding HasSafeReason}" TextWrapping="Wrap"/>
            <StackPanel Name="SafeBreakdown" Spacing="{StaticResource FieldGap}" IsVisible="{Binding HasBreakdown}">
              <StackPanel Spacing="{StaticResource Space1}">
                <TextBlock Theme="{StaticResource Label}" Text="İçinde ne var?"/>
                <TextBlock Theme="{StaticResource Hint}" Text="{Binding BreakdownHint}" TextWrapping="Wrap"/>
              </StackPanel>
              <ItemsControl Name="SafeItems" ItemsSource="{Binding SafeItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="{StaticResource RowGap}"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SafeItemRow">
                    <StackPanel Spacing="{StaticResource Space1}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                        <TextBlock Theme="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Theme="{StaticResource Hint}" Text="{Binding What}" TextWrapping="Wrap" IsVisible="{Binding HasWhat}"/>
                      <TextBlock Theme="{StaticResource Label}" Text="{Binding SkippedText}" IsVisible="{Binding HasSkipNote}"/>
                      <WrapPanel ItemSpacing="{StaticResource Space2}" LineSpacing="{StaticResource Space1}">
                        <Button Classes="ghost" Content="{Binding ExpandText}" IsVisible="{Binding CanExpand}"
                                Command="{Binding $parent[v:OverviewView].((vm:OverviewViewModel)DataContext).ExpandSafeCommand}" CommandParameter="{Binding}"/>
                        <Button Classes="ghost" Content="{Binding SkipText}" ToolTip.Tip="{Binding SkipTip}"
                                Command="{Binding $parent[v:OverviewView].((vm:OverviewViewModel)DataContext).SkipSafeCommand}" CommandParameter="{Binding}"/>
                      </WrapPanel>
                      <StackPanel Spacing="{StaticResource FieldGap}" IsVisible="{Binding IsExpanded}">
                        <TextBlock Theme="{StaticResource Hint}" Text="{Binding FilesNote}" IsVisible="{Binding HasFilesNote}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="{StaticResource Space1}"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SafeFileLine">
                              <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource FieldGap}">
                                  <TextBlock Theme="{StaticResource Hint}" Text="{Binding When}" VerticalAlignment="Center"/>
                                  <TextBlock Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding Size}" VerticalAlignment="Center"/>
                                  <Button Classes="link" Content="Klasörde göster" IsVisible="{Binding CanReveal}" VerticalAlignment="Center"
                                          ToolTip.Tip="Dosyayı dosya gezgininde seçili gösterir; açmaz, silmez"
                                          Command="{Binding $parent[v:OverviewView].((vm:OverviewViewModel)DataContext).RevealFileCommand}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <TextBlock Theme="{StaticResource Hint}" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Path}" Background="Transparent" VerticalAlignment="Center"/>
                              </DockPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Name="SafeUnits" ItemsSource="{Binding Units}" IsVisible="{Binding HasUnits}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="{StaticResource Space2}"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SafeUnitRow">
                              <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource FieldGap}">
                                  <TextBlock Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                  <Button Classes="link" Content="Klasörde göster" IsVisible="{Binding CanReveal}" VerticalAlignment="Center"
                                          ToolTip.Tip="Klasörü dosya gezgininde seçili gösterir; açmaz, silmez"
                                          Command="{Binding $parent[v:OverviewView].((vm:OverviewViewModel)DataContext).RevealUnitCommand}" CommandParameter="{Binding}"/>
                                  <Button Classes="link" Content="{Binding SkipText}" ToolTip.Tip="{Binding SkipTip}" VerticalAlignment="Center"
                                          Command="{Binding $parent[v:OverviewView].((vm:OverviewViewModel)DataContext).SkipUnitCommand}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Theme="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                  <TextBlock Theme="{StaticResource Hint}" Text="{Binding Place}" TextTrimming="CharacterEllipsis"
                                             ToolTip.Tip="{Binding Target}" Background="Transparent"/>
                                </StackPanel>
                              </DockPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="link" HorizontalAlignment="Left" Content="{Binding MoreUnitsText}" IsVisible="{Binding HasMoreUnits}"
                                Command="{Binding $parent[v:OverviewView].((vm:OverviewViewModel)DataContext).MoreUnitsCommand}" CommandParameter="{Binding}"/>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Name="AllSafeButton" Classes="link" HorizontalAlignment="Left" Content="{Binding AllSafeText}"
                      Command="{Binding ToggleAllSafeCommand}" IsVisible="{Binding HasAllSafeToggle}"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Name="UnusedStep" Spacing="{StaticResource FieldGap}" IsVisible="{Binding HasSnapshot}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding UnusedSizeText}" VerticalAlignment="Center"/>
              <TextBlock Theme="{StaticResource Body}" FontWeight="{StaticResource WeightSemi}" Text="2. Kullanmadıkların" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
              <TextBlock Theme="{StaticResource Hint}" Text="{Binding UnusedHow}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              <Button Name="MoreSpaceButton" Grid.Column="1" Classes="ghost" VerticalAlignment="Center"
                      Content="{Binding MoreText}" Command="{Binding MoreSpaceCommand}" IsVisible="{Binding HasMore}"
                      ToolTip.Tip="{Binding MoreTip}" ToolTip.ShowOnDisabled="True"/>
            </Grid>
            <TextBlock Theme="{StaticResource Body}" Text="{x:Static vm:OverviewViewModel.UnusedEmptyText}" IsVisible="{Binding IsUnusedEmpty}"/>
          </StackPanel>
          <StackPanel Name="UsedStep" Spacing="{StaticResource FieldGap}" IsVisible="{Binding HasSnapshot}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding UsedSizeText}" VerticalAlignment="Center"/>
              <TextBlock Theme="{StaticResource Body}" FontWeight="{StaticResource WeightSemi}" Text="3. Kullandıkların" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
              <TextBlock Theme="{StaticResource Hint}" Text="{x:Static vm:OverviewViewModel.UsedHow}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              <Button Name="UsedButton" Grid.Column="1" Classes="ghost" VerticalAlignment="Center"
                      Content="{Binding UsedText}" Command="{Binding OpenProgramsCommand}" IsVisible="{Binding HasUsed}"
                      ToolTip.Tip="{Binding UsedTip}"/>
            </Grid>
            <TextBlock Theme="{StaticResource Body}" Text="{x:Static vm:OverviewViewModel.UsedEmptyText}" IsVisible="{Binding IsUsedEmpty}"/>
          </StackPanel>
          <TextBlock Name="PlanTotal" Theme="{StaticResource Hint}" Classes="data" Text="{Binding PlanTotalText}" IsVisible="{Binding HasPlanTotal}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Name="TargetPanel" Theme="{StaticResource Panel}" IsVisible="{Binding HasSnapshot}">
        <ContentControl Content="{Binding Target}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:TargetViewModel">
              <StackPanel Spacing="{StaticResource FieldStack}">
                <StackPanel Spacing="{StaticResource FieldGap}">
                  <TextBlock Theme="{StaticResource H3}" Text="Bana ne kadar yer lazım?"/>
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <TextBox Name="GoalBox" Text="{Binding GoalText}" Width="{StaticResource SidebarWidth}" AutomationProperties.Name="Gereken yer, gigabayt"/>
                    <TextBlock Theme="{StaticResource Body}" Text="GB" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Name="GoalInvalid" Theme="{StaticResource Hint}" Text="{Binding InvalidText}" IsVisible="{Binding IsInvalid}"/>
                  <ItemsControl Name="GoalPresets" ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="{StaticResource Space2}" LineSpacing="{StaticResource Space2}"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TargetPreset">
                        <Button Classes="ghost" Content="{Binding Label}"
                                Command="{Binding $parent[ItemsControl].((vm:TargetViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Name="PlanWait" Theme="{StaticResource Hint}" Text="{Binding WaitText}" IsVisible="{Binding IsWaiting}" TextWrapping="Wrap"/>

                <StackPanel Name="PlanPanel" Spacing="{StaticResource RowGap}" IsVisible="{Binding HasPlan}">
                  <TextBlock Name="PlanHead" Theme="{StaticResource H3}" Classes="data" Text="{Binding HeadText}" TextWrapping="Wrap"/>
                  <ItemsControl Name="PlanRows" ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource FieldGap}"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PlanRow">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space3}">
                          <StackPanel>
                            <TextBlock Theme="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Theme="{StaticResource Hint}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                          <Button Grid.Column="2" Classes="ghost" Content="Plandan çıkar" VerticalAlignment="Center"
                                  IsVisible="{Binding $parent[ItemsControl].((vm:TargetViewModel)DataContext).IsEditing}"
                                  Command="{Binding $parent[ItemsControl].((vm:TargetViewModel)DataContext).ExcludeCommand}" CommandParameter="{Binding}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Name="PlanNow" Theme="{StaticResource Body}" Text="{Binding NowText}" TextWrapping="Wrap"/>
                  <Border Name="PlanShort" Theme="{StaticResource WarningPanel}" IsVisible="{Binding HasShort}">
                    <TextBlock Theme="{StaticResource WarningBody}" Text="{Binding ShortText}" TextWrapping="Wrap"/>
                  </Border>
                  <StackPanel Name="PlanSkipped" Spacing="{StaticResource FieldGap}" IsVisible="{Binding HasSkipped}">
                    <TextBlock Theme="{StaticResource Label}" Text="Plana girmeyenler"/>
                    <ItemsControl ItemsSource="{Binding Skipped}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="{StaticResource FieldGap}"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkipRow">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
                            <StackPanel>
                              <TextBlock Theme="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Theme="{StaticResource Hint}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Theme="{StaticResource Hint}" Text="{Binding MoreSkippedText}" IsVisible="{Binding HasMoreSkipped}"/>
                  </StackPanel>
                  <WrapPanel ItemSpacing="{StaticResource Space3}" LineSpacing="{StaticResource Space2}">
                    <Button Name="PlanConfirm" Classes="primary" Content="Onayla" Command="{Binding ConfirmCommand}"
                            ToolTip.Tip="{Binding ConfirmTip}" ToolTip.ShowOnDisabled="True"/>
                    <Button Name="PlanEdit" Classes="ghost" Content="{Binding EditText}" Command="{Binding EditCommand}" IsVisible="{Binding HasRows}"/>
                    <Button Name="PlanRestore" Classes="link" Content="Çıkardıklarımı geri koy" Command="{Binding RestoreCommand}" IsVisible="{Binding HasExcluded}"/>
                    <Button Name="PlanFreeNow" Classes="purge" Classes.ghost="{Binding !IsPurgeArmed}" Classes.danger="{Binding IsPurgeArmed}"
                            Content="{Binding FreeNowText}" Command="{Binding FreeNowCommand}" IsVisible="{Binding HasHeld}"
                            ToolTip.Tip="{Binding FreeNowTip}" ToolTip.ShowOnDisabled="True"/>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>

      <Border Name="CounterPanel" Theme="{StaticResource Panel}">
        <StackPanel Spacing="{StaticResource FieldGap}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Name="CounterText" Theme="{StaticResource Body}" Classes="data" Text="{Binding CounterText}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Name="FreeNowButton" Grid.Column="1" Classes="purge" Classes.ghost="{Binding !IsFreeNowArmed}" Classes.danger="{Binding IsFreeNowArmed}"
                    Content="{Binding FreeNowButtonText}" Command="{Binding FreeNowCommand}" IsVisible="{Binding HasFreeNow}"
                    ToolTip.Tip="{Binding FreeNowTip}" ToolTip.ShowOnDisabled="True"/>
          </Grid>
          <TextBlock Theme="{StaticResource Hint}" Text="{Binding LowDriveText}" IsVisible="{Binding HasLowDrive}" TextWrapping="Wrap"/>
          <Panel IsVisible="{Binding FreeProgress.IsRunning}">
            <v:TaskProgressView DataContext="{Binding FreeProgress}"/>
          </Panel>
        </StackPanel>
      </Border>

      <StackPanel Spacing="{StaticResource SectionGap}" IsVisible="{Binding ShowContent}">
        <Border Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource RowGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Sürücüler"/>
            <ListBox Name="DriveFilter" Theme="{StaticResource NavList}" ItemContainerTheme="{StaticResource ChipItem}"
                     ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" IsVisible="{Binding HasDrives}"
                     KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Sürücü süzgeci">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DriveChip">
                  <StackPanel Spacing="{StaticResource Space1}" Margin="{StaticResource InputPadding}">
                    <TextBlock Text="{Binding Label}"/>
                    <Border Height="{StaticResource Space2}" CornerRadius="{StaticResource Radius}"
                            Background="{StaticResource Renk1x10}" ClipToBounds="True">
                      <Border Classes="bar" CornerRadius="{StaticResource Radius}" Background="{StaticResource Renk1}"
                              RenderTransform="{Binding Share, Converter={x:Static v:UiConvert.ScaleX}}"/>
                    </Border>
                    <TextBlock Theme="{StaticResource Hint}" Classes="data" Text="{Binding Detail}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <CheckBox Name="RemovableToggle" IsChecked="{Binding ScanRemovable}"
                      ToolTip.Tip="USB bellek ve harici diskler de taranır; çıkarıldığında listeden düşer">
              <TextBlock Theme="{StaticResource Hint}" Text="Çıkarılabilir sürücüleri de tara"/>
            </CheckBox>
          </StackPanel>
        </Border>
        <Border Theme="{StaticResource Panel}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Theme="{StaticResource Hint}" Text="{Binding LastScanText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center" Spacing="{StaticResource Space1}">
              <TextBlock Theme="{StaticResource Label}" Text="Bekleyen"/>
              <TextBlock Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding PendingText}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="{StaticResource Space1}">
              <TextBlock Theme="{StaticResource Label}" Text="Açılan"/>
              <TextBlock Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding FreedText}"/>
            </StackPanel>
          </Grid>
        </Border>

        <Panel IsVisible="{Binding Growth.HasGrowth}">
          <v:GrowthCardView DataContext="{Binding Growth}"/>
        </Panel>

        <Border Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource RowGap}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Theme="{StaticResource H3}" Text="İlk beş teklif"/>
              <Button Grid.Column="1" Classes="link" Content="Tümünü gör" Command="{Binding OpenOffersCommand}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Top}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="{StaticResource FieldGap}"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TopUnit">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Theme="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Theme="{StaticResource Hint}">
                        <Run Text="{Binding KindLabel}"/><Run Text=" · "/><Run Text="{Binding UsageText}"/>
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource RowGap}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Theme="{StaticResource H3}" Text="Türe göre"/>
              <TextBlock Grid.Column="1" Theme="{StaticResource Hint}" FontFamily="{StaticResource FontMono}" Text="{Binding UnitCountText}" VerticalAlignment="Center"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Bars}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="{StaticResource FieldGap}"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KindBar">
                  <Grid ColumnDefinitions="160,*,120">
                    <TextBlock Theme="{StaticResource Body}" Text="{Binding Label}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" MinHeight="12" VerticalAlignment="Center" CornerRadius="{StaticResource Radius}"
                            Background="{StaticResource Renk1x10}" ClipToBounds="True">
                      <Border Classes="bar" CornerRadius="{StaticResource Radius}"
                              Background="{Binding Kind, Converter={x:Static v:UiConvert.KindFill}}"
                              BorderBrush="{Binding Kind, Converter={x:Static v:UiConvert.KindStroke}}"
                              BorderThickness="{StaticResource BorderWidth}"
                              RenderTransform="{Binding Share, Converter={x:Static v:UiConvert.ScaleX}}"/>
                    </Border>
                    <TextBlock Grid.Column="2" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>

      <Border Name="HistoryPanel" Theme="{StaticResource Panel}">
        <StackPanel Spacing="{StaticResource RowGap}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Theme="{StaticResource H3}" Text="{Binding MonthText}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space3}" VerticalAlignment="Center">
              <Button Name="OpenMeasureButton" Classes="link" Content="Ölçüm kaydını aç" Command="{Binding OpenMeasureCommand}"
                      ToolTip.Tip="Yalnız bu bilgisayarda tutulur, ağa gitmez; dosya gezgininde gösterilir"/>
              <CheckBox Name="WeeklyCheckToggle" IsChecked="{Binding WeeklyCheck}" ToolTip.Tip="{Binding WeeklyCheckTip}">
                <TextBlock Theme="{StaticResource Body}" Text="Haftalık disk kontrolü"/>
              </CheckBox>
            </StackPanel>
          </Grid>
          <TextBlock Theme="{StaticResource Hint}" Text="{Binding LastCleanupText}" IsVisible="{Binding HasLastCleanup}" TextWrapping="Wrap"/>
          <ItemsControl Name="CompareBars" ItemsSource="{Binding Compare}" IsVisible="{Binding HasCompare}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="{StaticResource FieldGap}"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KindBar">
                <Grid ColumnDefinitions="160,*,120">
                  <TextBlock Theme="{StaticResource Body}" Text="{Binding Label}" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" MinHeight="12" VerticalAlignment="Center" CornerRadius="{StaticResource Radius}"
                          Background="{StaticResource Renk1x10}" ClipToBounds="True">
                    <Border Classes="bar" CornerRadius="{StaticResource Radius}"
                            Background="{Binding Kind, Converter={x:Static v:UiConvert.KindFill}}"
                            BorderBrush="{Binding Kind, Converter={x:Static v:UiConvert.KindStroke}}"
                            BorderThickness="{StaticResource BorderWidth}"
                            RenderTransform="{Binding Share, Converter={x:Static v:UiConvert.ScaleX}}"/>
                  </Border>
                  <TextBlock Grid.Column="2" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

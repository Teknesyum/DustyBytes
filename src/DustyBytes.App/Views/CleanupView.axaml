<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DustyBytes.App.ViewModels"
             xmlns:v="using:DustyBytes.App.Views"
             x:Class="DustyBytes.App.Views.CleanupView"
             x:DataType="vm:CleanupViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,24,24,12" Spacing="{StaticResource FieldGap}">
      <TextBlock Theme="{StaticResource H2}" Text="Temizlik"/>
      <TextBlock Theme="{StaticResource Hint}" Text="Uyarılı seçenekler işaretsiz gelir; açık programların önbelleği atlanır." TextWrapping="Wrap"/>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderDecorative}"
            BorderThickness="0,1,0,0" Padding="{StaticResource PanelPadding}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Theme="{StaticResource Body}"><Run Text="{Binding TotalText}"/><Run Text="{Binding TotalSize}" FontFamily="{StaticResource FontMono}"/></TextBlock>
          <TextBlock Theme="{StaticResource Hint}" Text="{Binding Winapp2Text}" IsVisible="{Binding Winapp2}"/>
        </StackPanel>
        <Button Name="CleanButton" Grid.Column="1" Classes="primary" Content="Seçilenleri temizle"
                Command="{Binding CleanCommand}"
                ToolTip.Tip="{Binding DisabledTip}" ToolTip.ShowOnDisabled="True"/>
      </Grid>
    </Border>

    <Panel DockPanel.Dock="Top" Margin="24,0,24,12" IsVisible="{Binding IsLoading}">
      <v:TaskProgressView DataContext="{Binding Progress}"/>
    </Panel>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,0,24,24" Spacing="{StaticResource SectionGap}">
        <Border Theme="{StaticResource Panel}" IsVisible="{Binding HasError}">
          <StackPanel Spacing="{StaticResource FieldGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Kurallar okunamadı"/>
            <TextBlock Theme="{StaticResource DangerBody}" Text="{Binding Error}" TextWrapping="Wrap"/>
            <Button Classes="ghost" Content="Yeniden dene" HorizontalAlignment="Left" Command="{Binding LoadCommand}"/>
          </StackPanel>
        </Border>

        <Border Theme="{StaticResource Panel}" IsVisible="{Binding IsEmpty}">
          <StackPanel Spacing="{StaticResource FieldGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Temizlenecek bir şey yok"/>
            <TextBlock Theme="{StaticResource Hint}" Text="Bu bilgisayarda tanınan önbellek bulunamadı."/>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Rules}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="{StaticResource RowGap}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CleanRuleRow">
              <Border Theme="{StaticResource Panel}" Padding="16">
                <StackPanel Spacing="{StaticResource FieldGap}">
                  <StackPanel Spacing="{StaticResource Space1}">
                    <TextBlock Theme="{StaticResource H3}" Text="{Binding Name}" TextWrapping="Wrap"/>
                    <TextBlock Theme="{StaticResource Hint}" Text="{Binding Source}" IsVisible="{Binding HasSource}" TextWrapping="Wrap"
                               ToolTip.Tip="{Binding SourceTip}" Background="Transparent"/>
                  </StackPanel>
                  <TextBlock Theme="{StaticResource WarningBody}" Text="{Binding RunningText}" IsVisible="{Binding Running}" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CleanOptionRow">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                          <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,12,0"
                                    AutomationProperties.Name="{Binding Label}"/>
                          <StackPanel Grid.Column="1">
                            <TextBlock Theme="{StaticResource Body}" Text="{Binding Label}"/>
                            <TextBlock Theme="{StaticResource WarningBody}" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" TextWrapping="Wrap"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Theme="{StaticResource Panel}" Padding="16" IsVisible="{Binding HasSystemTasks}">
          <StackPanel Spacing="{StaticResource FieldGap}">
            <TextBlock Theme="{StaticResource H3}" Text="Sistem temizliği"/>
            <TextBlock Theme="{StaticResource Hint}" Text="Yönetici izni ister; bileşen deposu bu sürümde kapalı." TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding SystemTasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SystemTaskRow">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding Available}" VerticalAlignment="Top" Margin="0,2,12,0"
                              AutomationProperties.Name="{Binding Name}"
                              ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Theme="{StaticResource Body}" Text="{Binding Name}"/>
                      <TextBlock Theme="{StaticResource Hint}" Text="{Binding Detail}" TextWrapping="Wrap"/>
                      <TextBlock Theme="{StaticResource Hint}" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

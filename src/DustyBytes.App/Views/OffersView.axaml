<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DustyBytes.App.ViewModels"
             xmlns:v="using:DustyBytes.App.Views"
             x:Class="DustyBytes.App.Views.OffersView"
             x:DataType="vm:OffersViewModel">
  <UserControl.Styles>
    <Style Selector="Border.bar">
      <Setter Property="Background" Value="{StaticResource Renk1x10}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDecorative}"/>
      <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
      <Setter Property="MinHeight" Value="{StaticResource InputHeight}"/>
    </Style>
    <Style Selector="Border.row.pick">
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.row.pick:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
    </Style>
    <Style Selector="Border.row.selected">
      <Setter Property="Background" Value="{StaticResource Renk1x10}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource Renk1x10}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="CheckBox.wide">
      <Setter Property="MinWidth" Value="{StaticResource InputHeight}"/>
      <Setter Property="MinHeight" Value="{StaticResource InputHeight}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="CheckBox.placeholder">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,24,24,12" Spacing="{StaticResource FieldStack}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Theme="{StaticResource H2}" Text="Öneriler" VerticalAlignment="Center"/>
        <Button Name="AutoButton" Grid.Column="1" Classes.primary="{Binding !HasChosen}" Classes.ghost="{Binding HasChosen}"
                Content="Otomatik temizle" Command="{Binding AutoCleanCommand}" IsVisible="{Binding !NoScan}"
                ToolTip.Tip="Güvenli artıkları sormadan siler, büyük ve eski öğeleri tek tek sorar"/>
      </Grid>
      <ListBox Name="Filters" Theme="{StaticResource NavList}" ItemContainerTheme="{StaticResource ChipItem}"
               ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
               KeyboardNavigation.TabNavigation="Once"
               AutomationProperties.Name="Tür süzgeci">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:OfferFilter">
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <CheckBox Name="ShowSmallToggle" IsChecked="{Binding ShowSmall}" IsVisible="{Binding HasSmall}">
        <TextBlock Theme="{StaticResource Hint}" Text="{Binding SmallText}"/>
      </CheckBox>
      <TextBlock Name="StreamNotice" Theme="{StaticResource Hint}" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" TextWrapping="Wrap"/>
      <Grid Name="DuplicateSearch" ColumnDefinitions="*,Auto" IsVisible="{Binding Session.HasDuplicateStatus}">
        <TextBlock Name="DuplicateStatus" Theme="{StaticResource Hint}" Text="{Binding Session.DuplicateStatus}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Name="DuplicateCancel" Grid.Column="1" Classes="ghost" Content="Aramayı durdur" Margin="{StaticResource InputPadding}"
                Command="{Binding Session.CancelDuplicatesCommand}" IsVisible="{Binding Session.IsFindingDuplicates}"
                ToolTip.Tip="Kopya aramasını durdurur; bulunan gruplar kalır"/>
      </Grid>
      <CheckBox Name="SelectAll" Classes="wide" Margin="{StaticResource InputPadding}"
                IsChecked="{Binding AllSelected, Mode=OneWay}" Command="{Binding ToggleAllCommand}"
                IsVisible="{Binding HasBatch}" Content="Tümünü seç"/>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderDecorative}"
            BorderThickness="0,1,0,0" Padding="{StaticResource PanelPadding}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Theme="{StaticResource Body}" VerticalAlignment="Center"><Run Text="{Binding SelectionText}"/><Run Text="{Binding SelectionSize}" FontFamily="{StaticResource FontMono}"/></TextBlock>
        <Button Grid.Column="1" Classes="ghost" Content="Seçimi temizle" Margin="0,0,12,0"
                Command="{Binding ClearSelectionCommand}"/>
        <Button Name="PurgeButton" Grid.Column="2" Classes="purge" Classes.ghost="{Binding !IsBarArmed}" Classes.danger="{Binding IsBarArmed}"
                Content="{Binding PurgeBarText}" Margin="0,0,12,0"
                Command="{Binding PurgeSelectedCommand}"
                ToolTip.Tip="Karantinaya almadan siler; geri alınamaz"/>
        <Button Name="QuarantineButton" Grid.Column="3" Classes.primary="{Binding HasChosen}" Classes.ghost="{Binding !HasChosen}" Content="Seçilenleri karantinaya al"
                Command="{Binding QuarantineSelectedCommand}"
                ToolTip.Tip="{Binding DisabledTip}" ToolTip.ShowOnDisabled="True"/>
      </Grid>
    </Border>

    <Panel DockPanel.Dock="Top" Margin="24,0,24,12" IsVisible="{Binding Progress.IsRunning}">
      <v:TaskProgressView DataContext="{Binding Progress}"/>
    </Panel>

    <Panel>
      <Border Theme="{StaticResource Panel}" Margin="24,0" VerticalAlignment="Top" IsVisible="{Binding NoScan}">
        <StackPanel Spacing="{StaticResource FieldGap}">
          <TextBlock Theme="{StaticResource H3}" Text="Önce tarama gerekiyor"/>
          <TextBlock Theme="{StaticResource Hint}" Text="Genel bakış ekranında taramayı başlatın; öneriler burada toplanır."/>
          <Button Classes="link" Content="Genel bakışa git" HorizontalAlignment="Left" Command="{Binding OpenOverviewCommand}"/>
        </StackPanel>
      </Border>

      <Border Theme="{StaticResource Panel}" Margin="24,0" VerticalAlignment="Top" IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="{StaticResource FieldGap}">
          <TextBlock Theme="{StaticResource H3}" Text="{Binding EmptyText}"/>
          <TextBlock Theme="{StaticResource Hint}" Text="Başka bir tür seçin ya da taramayı yenileyin."/>
        </StackPanel>
      </Border>

      <StackPanel Name="Skeleton" Margin="24,0" Spacing="{StaticResource RowGap}" IsVisible="{Binding IsLoading}">
        <TextBlock Theme="{StaticResource Hint}" Text="{Binding LoadingText}"/>
        <Border Classes="skeleton" Theme="{StaticResource Panel}" Padding="16">
          <Grid ColumnDefinitions="2*,3*">
            <StackPanel Spacing="{StaticResource Space1}">
              <Border Classes="bar"><TextBlock Theme="{StaticResource H3}" Text=" "/></Border>
              <Border Classes="bar"><TextBlock Theme="{StaticResource Hint}" Text=" "/></Border>
              <Border Classes="bar"><TextBlock Theme="{StaticResource Hint}" Text=" "/></Border>
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="skeleton" Theme="{StaticResource Panel}" Padding="16">
          <Grid ColumnDefinitions="3*,2*">
            <StackPanel Spacing="{StaticResource Space1}">
              <Border Classes="bar"><TextBlock Theme="{StaticResource H3}" Text=" "/></Border>
              <Border Classes="bar"><TextBlock Theme="{StaticResource Hint}" Text=" "/></Border>
              <Border Classes="bar"><TextBlock Theme="{StaticResource Hint}" Text=" "/></Border>
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="skeleton" Theme="{StaticResource Panel}" Padding="16">
          <Grid ColumnDefinitions="1*,1*">
            <StackPanel Spacing="{StaticResource Space1}">
              <Border Classes="bar"><TextBlock Theme="{StaticResource H3}" Text=" "/></Border>
              <Border Classes="bar"><TextBlock Theme="{StaticResource Hint}" Text=" "/></Border>
              <Border Classes="bar"><TextBlock Theme="{StaticResource Hint}" Text=" "/></Border>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <ScrollViewer Name="CardScroller" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasCards}">
        <ItemsControl Name="CardList" ItemsSource="{Binding Cards}" Margin="24,0,24,12" Grid.IsSharedSizeScope="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UnitCard">
              <StackPanel Spacing="{StaticResource Space1}">
              <Border Classes="row" Classes.selected="{Binding IsSelected}" Classes.pick="{Binding IsBatch}" Tapped="OnRowTapped" DoubleTapped="OnRowTapped">
                <ToolTip.Tip>
                  <StackPanel Spacing="{StaticResource Space1}">
                    <TextBlock Theme="{StaticResource Body}" Text="{Binding Effect}" TextWrapping="Wrap"/>
                    <TextBlock Theme="{StaticResource Hint}" Text="{Binding Reason}" IsVisible="{Binding HasReason}"/>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Bu nedir? "/><Run Text="{Binding Explain.What}"/></TextBlock>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Silersem ne olur? "/><Run Text="{Binding Explain.IfDeleted}"/></TextBlock>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Geri gelir mi? "/><Run Text="{Binding Explain.Returns}"/></TextBlock>                    <TextBlock Theme="{StaticResource Hint}" FontFamily="{StaticResource FontMono}" Text="{Binding PathText}"/>
                  </StackPanel>
                </ToolTip.Tip>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="kind"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="usage"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="size"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="actions"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Classes="wide" IsChecked="{Binding IsSelected}"
                            Classes.placeholder="{Binding IsSingle}" IsEnabled="{Binding IsBatch}"
                            AutomationProperties.Name="{Binding Name}"/>
                  <TextBlock Grid.Column="1" Theme="{StaticResource Body}" FontWeight="{StaticResource WeightSemi}" Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space2}" Margin="{StaticResource InputPadding}" VerticalAlignment="Center">
                    <Border Classes="chip">
                      <TextBlock Theme="{StaticResource Label}" Text="{Binding KindLabel}"/>
                    </Border>
                    <Border Classes="chip" IsVisible="{Binding HasUserData}">
                      <TextBlock Theme="{StaticResource WarningBody}" FontSize="{StaticResource FontSize2}" Text="Kullanıcı verisi"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="3" Theme="{StaticResource Hint}" Text="{Binding UsageText}" TextWrapping="NoWrap"
                             Margin="{StaticResource InputPadding}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="4" Margin="{StaticResource InputPadding}" VerticalAlignment="Center">
                    <TextBlock Theme="{StaticResource MonoValue}" Classes="data" Text="{Binding SizeText}" HorizontalAlignment="Right" IsVisible="{Binding IsSettled}"/>
                    <TextBlock Theme="{StaticResource Hint}" Text="hesaplanıyor" HorizontalAlignment="Right" IsVisible="{Binding IsPending}"/>
                  </Panel>
                  <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="{StaticResource Space2}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="ghost" IsVisible="{Binding CanCompress}" Content="{Binding CompressText}"
                            ToolTip.Tip="{Binding CompressHint}" AutomationProperties.Name="Küçült"
                            Command="{Binding $parent[ItemsControl].((vm:OffersViewModel)DataContext).CompressOneCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="ghost" IsVisible="{Binding CanUncompress}" Content="Küçültmeyi geri al"
                            ToolTip.Tip="{Binding UncompressHint}"
                            Command="{Binding $parent[ItemsControl].((vm:OffersViewModel)DataContext).UncompressOneCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="ghost" IsVisible="{Binding CanCloudFree}" Content="Yalnız çevrimiçi yap"
                            ToolTip.Tip="{Binding CloudFreeHint}"
                            Command="{Binding $parent[ItemsControl].((vm:OffersViewModel)DataContext).CloudFreeOneCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="ghost" IsVisible="{Binding CanCloudKeep}" Content="Bu cihazda tut"
                            ToolTip.Tip="{Binding CloudKeepHint}"
                            Command="{Binding $parent[ItemsControl].((vm:OffersViewModel)DataContext).CloudKeepOneCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="ghost" IsVisible="{Binding IsBatch}" Content="{Binding ActionText}"
                            ToolTip.Tip="{Binding ActionHint}" AutomationProperties.Name="{Binding ActionText}"
                            Command="{Binding $parent[ItemsControl].((vm:OffersViewModel)DataContext).RemoveOneCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="purge" Classes.ghost="{Binding !IsPurgeArmed}" Classes.danger="{Binding IsPurgeArmed}"
                            IsVisible="{Binding CanPurge}" Content="{Binding PurgeText}"
                            ToolTip.Tip="{Binding PurgeHint}" AutomationProperties.Name="Kalıcı sil"
                            Command="{Binding $parent[ItemsControl].((vm:OffersViewModel)DataContext).PurgeOneCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="ghost" IsVisible="{Binding IsExternal}" Content="{Binding ExternalText}"
                            ToolTip.Tip="{Binding ExternalHint}"
                            Command="{Binding $parent[ItemsControl].((vm:OffersViewModel)DataContext).ExternalCommand}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Name="CopyList" Spacing="{StaticResource Space1}" Margin="{StaticResource InputPadding}" IsVisible="{Binding IsDuplicate}">
                <TextBlock Theme="{StaticResource Hint}" Text="{Binding KeepRule}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Copies}" Grid.IsSharedSizeScope="True">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CopyRow">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="copyState"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="copyAction"/>
                        </Grid.ColumnDefinitions>
                        <Border Classes="chip" IsVisible="{Binding IsKept}" Margin="{StaticResource InputPadding}">
                          <TextBlock Theme="{StaticResource Label}" Text="Kalacak"/>
                        </Border>
                        <TextBlock Theme="{StaticResource Hint}" Text="Karantinaya" IsVisible="{Binding IsOffered}"
                                   Margin="{StaticResource InputPadding}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Theme="{StaticResource Body}" FontWeight="{StaticResource WeightSemi}" FontFamily="{StaticResource FontMono}"
                                   Text="{Binding Path}" IsVisible="{Binding IsKept}" TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding Path}"/>
                        <TextBlock Grid.Column="1" Theme="{StaticResource Hint}" FontFamily="{StaticResource FontMono}"
                                   Text="{Binding Path}" IsVisible="{Binding IsOffered}" TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding Path}"/>
                        <Button Grid.Column="2" Classes="ghost" Content="Bunu tut" IsVisible="{Binding IsOffered}"
                                Command="{Binding KeepCommand}" AutomationProperties.Name="Bunu tut"
                                ToolTip.Tip="Bu kopya kalır, diğerleri karantinaya önerilir"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>

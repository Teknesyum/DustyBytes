<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DustyBytes</AssemblyName>
    <RootNamespace>DustyBytes.App</RootNamespace>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DustyBytes.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\DustyBytes.png" Link="DustyBytes.png" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaXaml Include="../../teknesyum-ui/avalonia/Theme.axaml" Link="Tema/Theme.axaml" />
    <AvaloniaResource Include="../../teknesyum-ui/avalonia/labels.tr.json" Link="Tema/labels.tr.json" />
    <AvaloniaXaml Include="../../teknesyum-ui/ustcubuk/*.axaml;../../teknesyum-ui/durum/*.axaml" Link="Kabuk/%(Filename)%(Extension)" />
    <Compile Include="../../teknesyum-ui/ustcubuk/*.cs;../../teknesyum-ui/durum/*.cs" Link="Kabuk/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.20" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DustyBytes.Core\DustyBytes.Core.csproj" />
    <ProjectReference Include="..\DustyBytes.Scan\DustyBytes.Scan.csproj" />
    <ProjectReference Include="..\DustyBytes.Signals\DustyBytes.Signals.csproj" />
    <ProjectReference Include="..\DustyBytes.Units\DustyBytes.Units.csproj" />
    <ProjectReference Include="..\DustyBytes.Clean\DustyBytes.Clean.csproj" />
    <ProjectReference Include="..\DustyBytes.Worker\DustyBytes.Worker.csproj" />
  </ItemGroup>
</Project>
